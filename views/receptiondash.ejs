<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Reception Dashboard | The Helper Hospital</title>
	<link rel="stylesheet" href="/nav.css">
</head>
<body class="dashboard-body">
	<div class="dashboard-layout">
		<%- include('_sidenav', { role: 'reception', active: 'dashboard' }) %>
		<main class="dashboard-main">
			<header class="dashboard-header">
				<div>
					<p class="eyebrow">Front desk workspace</p>
					<h1>Hello <%= user ? user.name : 'Receptionist' %></h1>
					<p class="dashboard-subtitle">Access patient and visitor records for The Helper Hospital.</p>
				</div>
				<a class="header-action" href="/PatientsDir">Open patient directory <span aria-hidden="true">&rarr;</span></a>
			</header>

			<section class="dashboard-grid reception-tools" aria-label="Reception tools">
				<article class="dashboard-card">
					<p class="eyebrow">Appointment services</p>
					<h2>Book for a patient</h2>
					<p class="dashboard-subtitle">Schedule a visit with a doctor for a registered patient.</p>
					<a class="header-action" href="/appointments">Book an appointment <span aria-hidden="true">&rarr;</span></a>
				</article>

				<article class="dashboard-card">
					<p class="eyebrow">Patient services</p>
					<h2>Patient directory</h2>
					<p class="dashboard-subtitle">Find patient records and review their assigned doctors.</p>
					<a class="header-action" href="/PatientsDir">View patient records <span aria-hidden="true">&rarr;</span></a>
				</article>

				<article class="dashboard-card">
					<p class="eyebrow">Visitor services</p>
					<h2>Visitor directory</h2>
					<p class="dashboard-subtitle">Review registered visitors and their associated patients.</p>
					<a class="header-action" href="/VisitorsDir">View visitor records <span aria-hidden="true">&rarr;</span></a>
				</article>
			</section>
		</main>
	</div>
</body>
</html>
